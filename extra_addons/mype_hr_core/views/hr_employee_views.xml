<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================
         Extensión de vista de empleado: Ocultar secciones no requeridas
    ========================================== -->

    <record id="view_mype_hr_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.mype</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Ocultar pestaña Currículum -->
            <xpath expr="//page[@name='resume']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Ocultar pestaña Nómina -->
            <xpath expr="//page[@name='payroll_information']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- =========================================
         Desactivar Botón de contratos en el empleado
    ========================================== -->

    <record id="view_mype_hr_employee_contract_button" model="ir.ui.view">
        <field name="name">hr.employee.form.mype.contract</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
            </xpath>
        </field>
    </record>

</odoo>
