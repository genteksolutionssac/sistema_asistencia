<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Búsqueda y Filtros -->
    <record id="view_mype_hr_document_assignment_search" model="ir.ui.view">
        <field name="name">mype.hr.document.assignment.search</field>
        <field name="model">mype.hr.document.assignment</field>
        <field name="arch" type="xml">
            <search string="Buscar Documentos">
                <field name="employee_id"/>
                <field name="template_id"/>
                <field name="batch_id"/>
                <field name="department_id"/>
                <separator/>
                <filter string="Pendientes de Firma" name="pending" domain="[('state', '=', 'pending')]"/>
                <filter string="Firmados" name="signed" domain="[('state', '=', 'signed')]"/>
                <group>
                    <filter string="Emisión / Lote" name="group_batch" context="{'group_by': 'batch_id'}"/>
                    <filter string="Plantilla" name="group_template" context="{'group_by': 'template_id'}"/>
                    <filter string="Departamento" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Colaborador" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Lista -->
    <record id="view_mype_hr_document_assignment_tree" model="ir.ui.view">
        <field name="name">mype.hr.document.assignment.list</field>
        <field name="model">mype.hr.document.assignment</field>
        <field name="arch" type="xml">
            <list string="Control de Documentos Asignados" default_order="state asc, id desc">
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="template_id"/>
                <field name="batch_id"/>
                <field name="date_issued"/>
                <field name="state" widget="badge" 
                    decoration-warning="state == 'pending'" 
                    decoration-success="state == 'signed'"/>
                <field name="date_signed_local" string="Fecha de Firma"/>
                <button name="action_download_pdf" 
                    string="Descargar" 
                    type="object" 
                    icon="fa-download" 
                    class="btn-link" 
                    invisible="state != 'signed'"/>
            </list>
        </field>
    </record>

    <!-- Formulario -->
    <record id="view_mype_hr_document_assignment_form" model="ir.ui.view">
        <field name="name">mype.hr.document.assignment.form</field>
        <field name="model">mype.hr.document.assignment</field>
        <field name="arch" type="xml">
            <form string="Documento Asignado">
                <header>
                    <button name="action_download_pdf" 
                        string="Descargar PDF Firmado" 
                        type="object" 
                        class="btn-primary" 
                        icon="fa-file-pdf-o" 
                        invisible="state != 'signed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,signed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="template_id" class="oe_edit_only"/>
                        <h1>
                            <field name="template_id" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Colaborador">
                            <field name="employee_id" readonly="1"/>
                            <field name="department_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group string="Emisión y Estado">
                            <field name="batch_id" readonly="1"/>
                            <field name="date_issued" readonly="1"/>
                            <field name="date_signed_local" readonly="1" invisible="state != 'signed'"/>
                        </group>
                    </group>

                    <group string="Auditoría y Firma Digital" invisible="state != 'signed'">
                        <group string="Firma del Colaborador">
                            <field name="employee_signature" widget="image" class="oe_avatar" options="{'size': [160, 80]}" readonly="1"/>
                        </group>
                        <group string="Evidencia Legal">
                            <field name="client_ip" readonly="1"/>
                            <field name="user_agent" readonly="1"/>
                            <field name="audit_hash" readonly="1"/>
                        </group>
                    </group>

                    <group string="Archivo PDF Definitivo" invisible="state != 'signed'">
                        <field name="pdf_signed" filename="pdf_signed_filename" widget="binary" readonly="1"/>
                        <field name="pdf_signed_filename" invisible="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Acción -->
    <record id="action_mype_hr_document_assignment" model="ir.actions.act_window">
        <field name="name">Control de Documentos</field>
        <field name="res_model">mype.hr.document.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mype_hr_document_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Consulte y descargue los documentos firmados o pendientes de sus colaboradores.
            </p>
        </field>
    </record>

</odoo>
