<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_documents_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.documents.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Asegurar DNI visible en Citizenship / Personal -->
            <xpath expr="//field[@name='identification_id']" position="attributes">
                <attribute name="string">DNI / Documento de Identidad</attribute>
                <attribute name="placeholder">ej. 72819203</attribute>
            </xpath>

            <!-- Mostrar Firma Digital Registrada (solo lectura) -->
            <xpath expr="//page[@name='personal_information']//group[last()]" position="after">
                <group string="Firma Digital para Documentos Laborales">
                    <field name="digital_signature" widget="image" class="oe_avatar" options="{'size': [160, 80]}" readonly="1"/>
                    <field name="has_digital_signature" invisible="1"/>
                    <p class="text-muted" colspan="2">
                        Esta firma fue registrada por el colaborador desde su app móvil y se estampa en sus documentos oficiales con su confirmación.
                    </p>
                </group>
            </xpath>

        </field>
    </record>

</odoo>
