<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================
         Regla de multiempresa
    ========================================== -->

    <record id="rule_mype_attendance_company" model="ir.rule">
        <field name="name">Asistencia: Multiempresa</field>
        <field name="model_id" ref="model_mype_attendance"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
