<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- =========================================
         Tree View de Dispositivos Vinculados
    ========================================== -->

    <record id="view_hr_employee_device_tree" model="ir.ui.view">
        <field name="name">hr.employee.device.tree</field>
        <field name="model">hr.employee.device</field>
        <field name="arch" type="xml">
            <list string="Dispositivos Vinculados">
                <field name="employee_id"/>
                <field name="device_id" optional="hide"/>
                <field name="phone" optional="show"/>
                <field name="device_model" optional="show"/>
                <field name="is_active" string="Estado" widget="badge"
                       decoration-success="is_active == 'True'"
                       decoration-danger="is_active == 'False'"/>
                <field name="enrolled_at"/>
                <field name="unbound_at" optional="hide"/>
                <field name="unbound_by" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- =========================================
         Form View de Dispositivo Vinculado
    ========================================== -->

    <record id="view_hr_employee_device_form" model="ir.ui.view">
        <field name="name">hr.employee.device.form</field>
        <field name="model">hr.employee.device</field>
        <field name="arch" type="xml">
            <form string="Dispositivo Vinculado">
                <header>
                    <button
                        name="action_unbind"
                        type="object"
                        string="Desvincular dispositivo"
                        class="btn-warning"
                        confirm="¿Desvincular este dispositivo? El token de la app quedará inválido y el colaborador deberá volver a enrolarse."
                        invisible="is_active != 'True'"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="device_id"/>
                            <field name="device_model"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="is_active" string="Estado"/>
                            <field name="enrolled_at"/>
                            <field name="unbound_at"/>
                            <field name="unbound_by"/>
                        </group>
                    </group>
                    <group string="Token (interno)">
                        <field name="token" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- =========================================
         Search View
    ========================================== -->

    <record id="view_hr_employee_device_search" model="ir.ui.view">
        <field name="name">hr.employee.device.search</field>
        <field name="model">hr.employee.device</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="device_id"/>
                <field name="phone"/>
                <filter string="Activos" name="active" domain="[('is_active','=','True')]"/>
                <filter string="Desvinculados" name="unbound" domain="[('is_active','=','False')]"/>
            </search>
        </field>
    </record>

    <!-- =========================================
         Action + Menú
    ========================================== -->

    <record id="action_hr_employee_device" model="ir.actions.act_window">
        <field name="name">Dispositivos Vinculados</field>
        <field name="res_model">hr.employee.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_employee_device_search"/>
        <field name="context">{}</field>
    </record>

</odoo>